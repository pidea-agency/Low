# The real public URL of the deployed frontend, e.g. https://your-domain.vercel.app — used in all outgoing WhatsApp/email links. Never leave unset in production.
FRONTEND_URL=https://your-domain.vercel.app

# Database & Storage (Supabase)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Security & Encryption
SESSION_SECRET=your-random-session-secret-min-32-chars
SETTINGS_ENCRYPTION_KEY=your-random-encryption-key-min-32-chars
CRON_SECRET=your-cron-secret-token

# Email Delivery (Resend)
RESEND_API_KEY=re_your_api_key_here
EMAIL_FROM="منظومة المحاماة <onboarding@resend.dev>"

# Optional / External APIs
HF_API_TOKEN=
HF_MODEL=Qwen/Qwen2.5-7B-Instruct
